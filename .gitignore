# Regenerable QA runs and binary render artifacts. Keep compact JSON manifests
# and Markdown certification notes visible to Git, but do not upload every
# locally rendered report page or repeated browser run.
data/validation/**/run-*/
data/validation/**/*.pdf
data/validation/**/*.png
data/validation/**/*.html
data/validation/**/*.tap
data/validation/**/*.log
data/validation/netlify-*-audit.json

# Local report-review output and manually supplied proof documents. Canonical
# synthetic fixtures used by tests live under tests/fixtures and remain tracked.
/reports/
/sample_proof_docs/
/*.pdf

data/raw/kern-assessor/*.zip

# ATTOM capability POC raw provider responses are local-only protected evidence.
data/validation/attom-poc/raw/

# First American/DataTree UAT raw responses are local-only pending retention/licensing review.
data/validation/datatree-uat/raw/

# ATTOM bulk Parquet samples are licensed local-only evidence.
data/validation/attom-bulk-poc/raw/

