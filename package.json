    "kern:import:status": "node scripts/kern-import-power-to-sell.js status",
    "kern:screen:test": "node scripts/qa-kern-screening.js",
    "kern:import:test": "node scripts/qa-kern-import.js",
    "kern:persistence:qa": "node scripts/qa-kern-opportunity-persistence.js",
    "rentcast:audit": "node scripts/rentcast-inspect-config.js",
    "deals:seed:florida": "node scripts/seed-florida-deals.js",
    "deals:verify:florida": "node scripts/verify-florida-properties.js",
