    "preview:persistence:qa": "node scripts/qa-netlify-preview-persistence.js",
    "db:preflight": "node scripts/db-migrate.js db:preflight",
    "db:status": "node scripts/db-migrate.js db:status",
    "db:migrate": "node scripts/db-migrate.js db:migrate",
    "db:schema:qa": "node scripts/qa-supabase-schema.js",
    "mao:test": "node scripts/qa-mao.js",
