# Copy this template to .env and fill in the key there. Never store keys in this example.
RENTCAST_API_KEY=
PI_RENTCAST_TIMEOUT_MS=18000
# Optional fallback; prefer RENTCAST_API_KEY.
MARKET_DATA_API_KEY=

# Supabase PostgreSQL Transaction Pooler URI. Server-only; keep the value in
# ignored .env / Netlify environment settings. Never expose it to the browser.
DATABASE_URL=

# Google Maps JavaScript street basemap: browser-visible key, NOT a server key.
# Restrict to Maps JavaScript API and http://127.0.0.1:4173/* in Google Cloud.
# Keep the real value in ignored .env. Never copy another application's secrets.
GOOGLE_MAPS_BROWSER_KEY=

# Firebase Authentication. PI_PUBLIC_* values are the browser-visible Firebase
# web app configuration. FIREBASE_PROJECT_ID and ADC credentials are server-only.
PI_PUBLIC_FIREBASE_API_KEY=
PI_PUBLIC_FIREBASE_AUTH_DOMAIN=
PI_PUBLIC_FIREBASE_PROJECT_ID=
PI_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
PI_FIREBASE_ORGANIZATION_ID=property-intelligence-local
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/your-user/.config/property-intelligence/firebase-service-account.json
# Netlify Functions cannot use the workstation path above. Store the same JSON
# as a protected, Functions-scoped base64 value in the Netlify dashboard.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# PI V2.5 private-development supporting-document storage. Normal `npm run
# pi:local` startup enables this only when the private bucket, deny-all client
# rules, server authorization and fail-closed malware scanner are configured.
# Do not reuse this configuration for public deployment or unrestricted users.
PI_FIREBASE_STORAGE_BUCKET=
PI_MALWARE_SCANNER_URL=
PI_MALWARE_SCANNER_AUDIENCE=
PI_MALWARE_SCANNER_TIMEOUT_MS=60000
PI_MALWARE_SIGNATURE_MAX_AGE_HOURS=24

# PI V3 commercial controls. All activation flags default to false in code.
# Keep Stripe keys server-only. Start with sk_test_/whsec_ test credentials;
# a live key is rejected unless the separate live-mode flag is explicitly true.
PI_EXTERNAL_BETA_ENABLED=false
PI_STRIPE_CHECKOUT_ENABLED=false
PI_STRIPE_LIVE_MODE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PI_STRIPE_SUCCESS_URL=https://worksidepropertyintelligence.netlify.app/#my-workspace
PI_STRIPE_CANCEL_URL=https://worksidepropertyintelligence.netlify.app/#my-workspace

# Historical Kern POC settings. Foundation Sprint 1 does not query Kern.
KERN_MAPSERVER_URL=https://maps.kerncounty.com/arcgis/rest/services/Assessor/Assessor_Public/MapServer
KERN_PARCEL_LAYER_ID=2
KERN_REQUEST_TIMEOUT_MS=15000
KERN_REQUEST_DELAY_MS=150
KERN_MAX_RETRIES=4
